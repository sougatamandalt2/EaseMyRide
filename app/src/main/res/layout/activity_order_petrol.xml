<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".order_petrol_activity">

    <RelativeLayout
        android:id="@+id/rl_heading"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/shape_05">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:src="@drawable/back_white" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="40dp"
            android:text="Place Your Order"
            android:textColor="@color/white"
            android:textSize="20dp"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/about_black"/>

    </RelativeLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:id="@+id/textField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Registration Number of Your Vechicle :"
        android:layout_marginStart="15dp"
        android:inputType="text"
        android:textSize="20dp"
        app:startIconDrawable="@drawable/car_black"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="25dp"
        android:layout_below="@+id/rl_heading"
        android:layout_marginEnd="15dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/textstyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menu"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_below="@+id/textField"
        android:layout_margin="15dp"
        android:hint="Select Petrol by Price : "
        app:startIconDrawable="@drawable/money_black">

        <AutoCompleteTextView
            android:id="@+id/dropdown_menu"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:inputType="none"

            />

    </com.google.android.material.textfield.TextInputLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/menu"
        android:layout_marginTop="50dp"
        android:background="@drawable/shape_border"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="10dp">
<!--        android:visibility="invisible"-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:weightSum="4">
            <TextView
                android:id="@+id/tv_order_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Details : "
                android:gravity="center"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_margin="10dp"
                android:layout_weight="1"
                />

            <LinearLayout
                android:id="@+id/ll_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layout_weight="2"
                android:layout_below="@id/tv_order_details"
                android:paddingStart="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:text="Petrol Price : "
                    android:textSize="20dp"
                    android:textAlignment="textStart"
                     />
                <TextView
                    android:id="@+id/petrol_price"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:text="150"
                    android:paddingRight="40dp"
                    android:textSize="25dp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_alignBottom="@id/ll_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:paddingStart="20dp"
                android:layout_below="@id/tv_order_details"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:text="Delivery Fee : "
                    android:textSize="20dp"
                    android:textAlignment="textStart"
                    />
                <TextView
                    android:id="@+id/delivery_price"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:text="50"
                    android:paddingRight="40dp"
                    android:textSize="25dp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_alignBottom="@id/ll_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:paddingStart="20dp"
                android:layout_below="@id/tv_order_details"
                android:layout_marginTop="30dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:text="Total Price : "
                    android:textSize="20dp"
                    android:textAlignment="textStart"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/total_price"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:text="50"
                    android:paddingRight="40dp"
                    android:textSize="30dp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    />
            </LinearLayout>
        </LinearLayout>


    </RelativeLayout>

    <Button
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:text=" Place Your Order "
        android:background="@drawable/shape03"
        />

</RelativeLayout>